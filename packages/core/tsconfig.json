{
  "compileOnSave": false,
  "compilerOptions": {
    "declaration": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "declarationMap": true,
    "resolveJsonModule": true,
    "lib": [
      "esnext",
      "dom"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__mocks__",
    "**/tests",
    "**/*.spec.ts"
  ]
}