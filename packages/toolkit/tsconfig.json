{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "rootDirs": [
      "./dist"
    ],
    "outDir": "./dist",
    "declaration": true,
    "downlevelIteration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "lib": [
      "es2018",
      "dom"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__mocks__",
    "**/tests",
    "**/*.spec.ts"
  ]
}