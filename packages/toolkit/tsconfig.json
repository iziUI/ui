{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDirs": [
      "./dist"
    ],
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "lib": [
      "es2018",
      "dom"
    ],
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__mocks__"
  ]
}